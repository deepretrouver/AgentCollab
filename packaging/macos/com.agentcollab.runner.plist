<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentcollab.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/.agentcollab/bin/agentcollab-runner</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Users/example/AgentCollab-local/config/runner.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/example</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/example</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/example/.agentcollab/logs/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/example/.agentcollab/logs/runner.stderr.log</string>
</dict>
</plist>
