{
  "name": "agentcollab-server-desktop",
  "version": "1.3.3",
  "private": true,
  "description": "AgentCollab Server for a fixed team host",
  "main": "main.cjs",
  "author": "AgentCollab",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.agentcollab.server.v1",
    "productName": "AgentCollab Server",
    "artifactName": "AgentCollab-Server-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "lifecycle.cjs",
      "major-version.cjs",
      "network.cjs",
      "preload.cjs",
      "onboarding/**/*",
      "dashboard/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "client-packages",
        "to": "client-packages",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runner-packages",
        "to": "runner-packages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": false,
        "NSHumanReadableCopyright": "AgentCollab Server"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "安装 AgentCollab Server",
      "sign": false
    }
  }
}
